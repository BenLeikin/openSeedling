# Reference for .env, which scripts/setup.sh writes (mode 600, gitignored) and
# the systemd unit reads. Values here override dashboard settings. Edit .env
# and run: sudo systemctl restart growlight
#
# A key set to an empty value means "none": that device is never claimed.
# A key that is absent falls back to the default shown here.
# GPIO25 is dead on the current Pi; never assign it.

# 5V panel via D4184 MOSFET; hardware PWM channel 0 (18 = header pin 12)
GROWLIGHT_LIGHT_PIN=18
# AC fixture dim line via PC817; hardware PWM channel 1 (19 = header pin 35)
GROWLIGHT_DIM_PIN=19
# tray:pin
GROWLIGHT_PUMP_PINS=1:24,2:26
GROWLIGHT_FLOAT_PINS=1:23,2:22
# software PWM
GROWLIGHT_FAN_PIN=20
# XKC-Y23A NPN; set INVERT=1 only if the bench test reads backwards
GROWLIGHT_RESERVOIR_PINS=low:27,high:17
#GROWLIGHT_RESERVOIR_INVERT=1

# TP-Link plug for the kasa light backend. USER/PASS only for KLAP firmware.
GROWLIGHT_KASA_HOST=
#GROWLIGHT_KASA_USER=
#GROWLIGHT_KASA_PASS=

# debug, info (default), warning, error; LOG_FILE adds a rotating file
#GROWLIGHT_LOG_LEVEL=info
#GROWLIGHT_LOG_FILE=/var/tmp/growlight.log

#ANTHROPIC_API_KEY=
#DISCORD_WEBHOOK=
