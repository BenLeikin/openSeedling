# Reference for .env, which scripts/setup.sh writes (mode 600, gitignored) and
# the systemd unit reads. Values here override dashboard settings. Edit .env
# and run: sudo systemctl restart growlight
#
# A key set to an empty value means "none": that device is never claimed.
# A key that is absent falls back to the default shown here.
# GPIO25 is dead on the current Pi; never assign it.

# 5V panel via D4184 MOSFET; hardware PWM channel 0 (18 = header pin 12)
GROWLIGHT_LIGHT_PIN=18
# AC fixture dim line via PC817; hardware PWM channel 1 (19 = header pin 35)
GROWLIGHT_DIM_PIN=19
# tray:pin
GROWLIGHT_PUMP_PINS=1:24,2:26
GROWLIGHT_FLOAT_PINS=1:23,2:22
# software PWM
GROWLIGHT_FAN_PIN=20
# XKC-Y23A NPN; set INVERT=1 only if the bench test reads backwards
GROWLIGHT_RESERVOIR_PINS=low:27,high:17
#GROWLIGHT_RESERVOIR_INVERT=1

# TP-Link plug for the kasa light backend. USER/PASS only for KLAP firmware.
GROWLIGHT_KASA_HOST=
#GROWLIGHT_KASA_USER=
#GROWLIGHT_KASA_PASS=

# The dashboard's port. With the touchscreen kiosk installed (scripts/kiosk.sh
# sets TRUST_LOCALHOST), the screen gets SCREEN_PORT on 127.0.0.1, where
# requests are signed in without a password. Never expose or proxy that port.
#GROWLIGHT_HTTP_PORT=5000
#GROWLIGHT_TRUST_LOCALHOST=1
#GROWLIGHT_SCREEN_PORT=5001
# Other names the dashboard answers to while it has no password (it always
# answers to its IP address, localhost and the Pi's hostname).
#GROWLIGHT_ALLOWED_HOSTS=grow.lan
# The IP address of a reverse proxy that serves the dashboard over HTTPS. Its
# X-Forwarded-For and X-Forwarded-Proto headers are believed; nobody else's.
#GROWLIGHT_TRUSTED_PROXY=10.0.0.5

# debug, info (default), warning, error; LOG_FILE adds a rotating file, which
# has to be in the app folder (the service cannot write anywhere else)
#GROWLIGHT_LOG_LEVEL=info
#GROWLIGHT_LOG_FILE=/home/pi/growlight/growlight.log

#ANTHROPIC_API_KEY=
#DISCORD_WEBHOOK=
